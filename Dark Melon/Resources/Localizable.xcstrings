    "Dark Melon" : {
      "shouldTranslate" : false
    },
    "Dark Melon needs access to %@ to read and save the image’s edit sidecar. Select that folder once to remember access for future sessions. Opening only the image does not grant access to its sidecar." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark Melonが画像の編集サイドカーを読み書きするには、%@へのアクセスが必要です。一度このフォルダを選択すると、次回以降もアクセスできます。画像だけを開いても、サイドカーへのアクセス権は付与されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark Melon 需要访问 %@ 才能读取和保存图像的编辑附属文件。选择该文件夹一次后，即可记住访问权限。仅打开图像不会授予其附属文件的访问权限。"
          }
        }
      }
    },
    "Darker" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
