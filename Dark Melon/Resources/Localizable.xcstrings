    "HDR" : {
      "shouldTranslate" : false
    },
    "HDR cannot be darker than SDR. The curves cross." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRをSDRより暗くすることはできません。カーブが交差しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 不能比 SDR 更暗。两条曲线发生了交叉。"
          }
        }
      }
    },
    "HDR encoding" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRエンコード"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 编码"
          }
        }
      }
    },
    "HDR Gain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRゲイン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 增益"
          }
        }
      }
    },
    "HDR Gain is off. This LUT is currently bypassed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRゲインがオフです。現在、このLUTは適用されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 增益已关闭。当前将跳过此 LUT。"
          }
        }
      }
    },
    "HDR gain map" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRゲインマップ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 增益图"
          }
        }
      }
    },
    "HDR Gain multiplies the entire HDR curve. 1× keeps the automatically calculated rendition, 2× doubles its linear brightness, and 0 turns HDR off. Tone, Contrast, and white point update the hidden HDR Target without changing this multiplier." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRゲインはHDRカーブ全体に乗算されます。1倍では自動計算された描写を維持し、2倍ではリニア輝度を2倍にし、0ではHDRをオフにします。トーン、コントラスト、白色点は、この倍率を変えずに非表示のHDRターゲットを更新します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 增益乘以整条 HDR 曲线。1× 保留自动计算的效果，2× 使线性亮度加倍，0 关闭 HDR。影调、对比度和白场会更新隐藏的 HDR 目标值，而不改变此倍数。"
          }
        }
      }
    },
    "HDR is enabled, but this display has no EDR capability." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRは有効ですが、このディスプレイはEDRに対応していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 已开启，但此显示器不具备 EDR 能力。"
          }
        }
      }
    },
    "HDR is enabled, but this display has no EDR capability. HDR brightness cannot be shown on this display." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRは有効ですが、このディスプレイはEDRに対応していません。このディスプレイではHDRの明るさを表示できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 已开启，但此显示器不具备 EDR 能力，无法显示 HDR 亮度。"
          }
        }
      }
    },
    "HDR is off. Raise HDR Gain above Off, then use the Preview toggle to compare HDR and SDR." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRがオフです。HDRゲインを上げてから、プレビュー切り替えでHDRとSDRを比較してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 已关闭。将 HDR 增益调至开启状态，再使用预览按钮对比 HDR 与 SDR。"
          }
        }
      }
    },
    "HDR Off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRオフ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 已关闭"
