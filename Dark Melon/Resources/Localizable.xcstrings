      }
    },
    "The saved development settings contain invalid values." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの現像設定に無効な値が含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的显影设置包含无效数值。"
          }
        }
      }
    },
    "The unreadable library was backed up. A new library has been created." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取れないライブラリをバックアップし、新しいライブラリを作成しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取的资料库已备份，并已创建新的资料库。"
          }
        }
      }
    },
    "There are unsaved edits for %lld file(s). Save them or discard them before continuing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のファイルに未保存の編集があります。続ける前に保存または破棄してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个文件的编辑尚未保存。请保存或放弃这些编辑后再继续。"
          }
        }
      }
    },
    "These settings will apply to every photo you open and every export, including batch exports, overriding saved settings where they differ. Any resulting changes remain unsaved until you save them. Consider whether you want to save edits made from this point forward." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの設定は、今後開くすべての写真と、一括書き出しを含むすべての書き出しに適用され、異なる保存済み設定を上書きします。変更内容は保存するまで未保存のままです。以後の編集を保存するかどうかを検討してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些设置将应用于之后打开的每张照片及所有导出（包括批量导出），并覆盖与其不同的已保存设置。产生的更改在您保存前均为未保存状态。请考虑是否要保存从现在起所做的编辑。"
          }
        }
      }
    },
    "This development recipe uses an unsupported version or is too large." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この現像レシピは、対応していないバージョンを使用しているか、サイズが大きすぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此显影设置的版本不受支持，或数据过大。"
          }
        }
      }
    },
    "This display does not support HDR" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイはHDRに対応していません"
