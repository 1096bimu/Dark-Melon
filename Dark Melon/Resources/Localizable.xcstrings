            "state" : "translated",
            "value" : "双重曝光的源图像必须是两个 RAW 文件。"
          }
        }
      }
    },
    "The dust sampling line must stay inside the image." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミのサンプリング線は画像内に収めてください。"
