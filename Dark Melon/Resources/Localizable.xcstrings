    "Turbo" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターボ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加速模式"
          }
        }
      }
    },
    "Turbo prepares RAW photos in the background so they open faster. Choose when it turns on automatically. It uses more processing power and energy while preparing photos." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターボはRAW写真をバックグラウンドで準備し、開くまでの時間を短縮します。自動的に有効にするタイミングを選択できます。準備中は処理負荷と消費電力が増えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turbo会在后台预处理RAW照片，以便更快打开。你可以选择自动启用的时机。准备照片时会增加处理负载和耗电量。"
          }
        }
      }
    },
    "Turning everything off hides the info pill. Comparison and crop controls remain available." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてオフにすると情報ピルを隠します。比較と切り抜きのコントロールは引き続き使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭所有项目即可隐藏信息胶囊。对比和裁剪控件仍然可用。"
          }
        }
      }
    },
    "Tutorial complete" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チュートリアル完了"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教程完成"
          }
        }
      }
    },
    "Two tone curves. SDR reaches one at the white point; HDR reaches its maximum at input one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本のトーンカーブです。SDRは白色点で1に達し、HDRは入力が1のときに最大値に達します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两条影调曲线。SDR 在白场处达到 1；HDR 在输入为 1 时达到最大值。"
          }
        }
      }
    },
    "Unable to allocate GPU resources for the histogram." : {
      "extractionState" : "manual",
