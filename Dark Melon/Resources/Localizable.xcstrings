    "Digital" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デジタル"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数码"
          }
        }
      }
    },
    "Digital uses additive grain and color matrices. Analogue combines grain, dye response, and purity in a shared film density response." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デジタルは加算粒子とカラーマトリクスを使用します。アナログは粒子、色素応答、純度を共通のフィルム濃度応答で処理します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数码模式使用加法颗粒和颜色矩阵。模拟模式在同一个胶片密度响应中处理颗粒、染料响应与纯度。"
          }
        }
      }
    },
    "Dimensions" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像サイズ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像尺寸"
          }
        }
      }
    },
    "Dims the screen from HDR brightness to avoid burn-in." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRの明るさを抑え、画面の焼き付きを防ぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低屏幕的 HDR 亮度，避免烧屏。"
          }
        }
      }
    },
    "Direct HDR" : {
      "extractionState" : "manual",
