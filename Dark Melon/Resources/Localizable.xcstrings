    "Tone adjustment is ineffective at low contrast." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストが低い場合、トーン調整は効果がありません。"
