    "Remove saved settings and discard pending edits for %lld file(s)? Original images are kept. If Trash is unavailable, settings sidecars are permanently deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld個のファイルの保存済み設定を削除し、未保存の編集を破棄しますか？元画像は保持されます。ゴミ箱を利用できない場合、設定サイドカーは完全に削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 %lld 个文件的已保存设置并放弃待保存的编辑？原始图像将保留。如果废纸篓不可用，设置附属文件将被永久删除。"
