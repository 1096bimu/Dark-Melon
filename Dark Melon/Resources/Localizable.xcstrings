        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此显示器不支持 HDR"
          }
        }
      }
    },
    "This image format is not supported by Core Image." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Core Imageはこの画像形式に対応していません。"
