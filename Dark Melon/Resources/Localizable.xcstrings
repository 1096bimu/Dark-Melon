    },
    "The encoder could not create an ISO HDR gain map for this SDR/HDR pair." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このSDRとHDRの組み合わせから、ISO HDRゲインマップを作成できませんでした。"
