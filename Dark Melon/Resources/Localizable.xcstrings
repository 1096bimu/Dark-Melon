    "Fade the HDR preview to SDR when the app loses focus or after one minute without mouse or keyboard input. Activity restores HDR without changing the selected preview mode." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリからフォーカスが外れたとき、またはマウスやキーボードの操作が1分間ないときに、HDRプレビューをSDRまで暗くします。操作を再開すると、選択中のプレビューモードを変えずにHDRへ戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
