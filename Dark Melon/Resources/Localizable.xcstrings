    },
    "This switch makes color transformations look more natural instead of mathematically correct, it will not have any effect when no transform is applied." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスイッチは、色変換を数学的な正確さよりも自然な見た目に近づけます。変換が適用されていない場合は効果がありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此开关让色彩变换看起来更自然，而非追求数学上的正确性。未应用变换时不会产生任何效果。"
          }
        }
      }
    },
