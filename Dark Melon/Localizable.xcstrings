    },
    "Capture film settings and apply them as unsaved edits when opening another photo. Unlock to stop applying them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录当前胶片设置，在打开其他照片时作为未保存的编辑应用。解除锁定后停止应用。"
          }
        }
      }
    },
    "Changes relative RGB contrast in the tone map. The shared average is ignored, so equal values have no effect." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改变色调映射中的 RGB 相对对比度。忽略共同的平均值，因此相等的数值不会产生效果。"
          }
        }
      }
    },
    "Choose Export… in the top bar (⇧⌘E on Mac), pick a format and settings, then save the exported image. JPEG or HEIF with HDR enabled can include a gain map for compatible displays." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击顶部的“导出…”（Mac 上为 ⇧⌘E），选择格式和设置，然后保存导出的图像。启用 HDR 的 JPEG 或 HEIF 可包含供兼容显示设备使用的增益图。"
          }
        }
      }
    },
    "Choose Folder…" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择文件夹…"
          }
        }
      }
    },
    "Choose Save Edits in the top bar (⌘S on Mac). This saves an XMP sidecar beside your original, so your development settings can be restored." : {
      "extractionState" : "manual",
