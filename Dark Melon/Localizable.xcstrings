    "10-bit PQ HDR without a gain map. SDR appearance is determined by the viewer.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不含增益图的 10 位 PQ HDR。SDR 显示效果由查看器决定。"
